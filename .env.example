# === V5.8 NEW API KEYS (optional — skip if not registered) ===
# EIA (energy stats) — free: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# USDA (agriculture) — free: https://quickstats.nass.usda.gov/api
USDA_API_KEY=
# NVD (CVE search) — free: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Caselaw Access Project (legal) — free: https://case.law/user/register/
CASE_LAW_API_KEY=

# === [OPT-3/4] New DataSources (cross-check existing sources) ===
# AlphaVantage — stocks/forex/crypto cross-check for CoinGecko
# Free tier: 25 calls/day — https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# NewsAPI — structured news headlines for RealLearning verification
# Free tier: 100 requests/day — https://newsapi.org/register
NEWSAPI_API_KEY=

# === [ROOT-FIX] GitHub API token — prevents 403 rate limit exceeded ===
# Without token: 60 requests/hour (SCP needs 28/cycle × 6 cycles = 168/hour → 403)
# With token: 5000 requests/hour (more than enough)
# Get free token: https://github.com/settings/tokens (create "Personal Access Token" with public_repo scope)
GITHUB_TOKEN=

# === [ROOT-FIX 46] AutoFix + Capability config ===
# AutoFix: re-enabled BareExceptPass (V4 flash stronger than llama3.2:3B)
# If rollback rate stays high, set to 1 to re-skip:
SCP_SKIP_BAREEXCEPTPASS=

# Max bugs per startup audit (was 50, now 200 — no more capping)
SCP_MAX_STARTUP_BUGS=

# Capability level (Gà §12):
#   0 = ANALYSIS_ONLY (scan only, no fix)
#   1 = SIMULATION (simulate fixes)
#   2 = SANDBOX (apply to test files only)
#   3 = LIMITED_ENV (staging)
#   4 = NARROW_PRODUCTION (production, scope hẹp) ← RECOMMENDED
#   5 = FULL_PRODUCTION (unrestricted)
SCP_CAPABILITY_LEVEL=YOUR_SCP_CAPABILITY_LEVEL_HERE
