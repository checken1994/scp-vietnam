# ============================================================
# SCP V104.49 — Environment Variables (EXAMPLE — no real keys)
# Copy to `.env` and fill in your own keys. NEVER commit `.env`.
# ============================================================

# === OpenRouter — LLM chính + Web Search ===
# Get keys at https://openrouter.ai/keys
# [SECURITY] PREVIOUS KEYS WERE LEAKED IN GIT HISTORY — REVOKE at https://openrouter.ai/keys
# Generate new keys and set them below. NEVER commit real keys to git.
# [ROOT-FIX 44-A] OpenRouter is now the ONLY cloud provider — DeepSeek /
# Anthropic / OpenAI direct providers removed (user has no keys for them).
# [OPENROUTER-FREE-FIX] 3 API keys configured for round-robin load balancing.
#   Each key has $15 credit limit (FREE models cost $0, so credit lasts long).
#   Gateway rotates between keys to avoid rate limits (20 req/min per key).
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_API_KEY_2=YOUR_OPENROUTER_API_KEY_2_HERE
OPENROUTER_API_KEY_3=YOUR_OPENROUTER_API_KEY_3_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# [PAID MODEL — primary, kept as user requested]
# deepseek-v4-flash is a PAID model ($0.04/$0.12 per 1M tokens). Used as the
# primary model for high-quality tasks. FREE models below are fallback.
OPENROUTER_MODEL=YOUR_OPENROUTER_MODEL_HERE

# ============================================================
# [OPENROUTER-FREE-FIX] 17 FREE MODELS — full list + task routing
# ============================================================
# All 17 models below are FREE (pricing.prompt=0 AND pricing.completion=0).
# Verified via https://openrouter.ai/api/v1/models on 2026-08-06.
# Total FREE models on OpenRouter: 17 (snapshot — list refreshes weekly).
#
# To refresh the free model list:
#   curl -s https://openrouter.ai/api/v1/models | \
#   python3 -c "import json,sys; [print(m['id']) for m in json.load(sys.stdin)['data'] \
#   if m.get('pricing',{}).get('prompt')=='0' and m.get('pricing',{}).get('completion')=='0']"
#
# --- FULL LIST OF 17 FREE MODELS (with context length + capabilities) ---
#   1.  nvidia/nemotron-3-ultra-550b-a55b:free           ctx=1,000,000  tools+reasoning (550B — strongest)
#   2.  google/lyria-3-pro-preview                        ctx=1,048,576  (image — image gen)
#   3.  google/lyria-3-clip-preview                       ctx=1,048,576  (image — image gen)
#   4.  inclusionai/ling-3.0-tiny:free                    ctx=262,144    tools+reasoning (multilingual)
#   5.  poolside/laguna-s-2.1:free                        ctx=262,144    tools+reasoning (code)
#   6.  poolside/laguna-xs-2.1:free                       ctx=262,144    tools+reasoning (code, smaller)
#   7.  google/gemma-4-26b-a4b-it:free                    ctx=262,144    tools+reasoning+image (26B)
#   8.  google/gemma-4-31b-it:free                        ctx=262,144    tools+reasoning+image (31B)
#   9.  nvidia/nemotron-3-super-120b-a12b:free            ctx=262,144    tools+reasoning (120B — balanced)
#  10.  cohere/north-mini-code:free                       ctx=256,000    tools+reasoning (code)
#  11.  nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free ctx=256,000   tools+reasoning+audio+image+video
#  12.  nvidia/nemotron-3-nano-30b-a3b:free               ctx=256,000    tools+reasoning (30B)
#  13.  openrouter/free                                    ctx=200,000    tools+reasoning (auto-router)
#  14.  openai/gpt-oss-20b:free                            ctx=131,072    tools+reasoning (20B — fast)
#  15.  nvidia/nemotron-3.5-content-safety:free           ctx=128,000    reasoning+image (content moderation)
#  16.  nvidia/nemotron-nano-12b-v2-vl:free               ctx=128,000    tools+reasoning+image+video (12B)
#  17.  nvidia/nemotron-nano-9b-v2:free                    ctx=128,000    tools+reasoning (9B — fastest)
#
# --- TASK → FREE MODEL MAPPING (used when PAID model unavailable/quota exhausted) ---
#   autofix       → nvidia/nemotron-3-ultra-550b-a55b:free  (550B, 1M ctx — strongest code reasoning)
#   why           → google/gemma-4-31b-it:free               (31B, 262K ctx — factual, multilingual)
#   learning      → google/gemma-4-31b-it:free               (31B, 262K ctx — summarization)
#   fast_learning → nvidia/nemotron-3-nano-30b-a3b:free      (30B, 256K ctx — mid-tier)
#   judge         → nvidia/nemotron-3-super-120b-a12b:free   (120B, 262K ctx — balanced reasoning)
#   chat          → openai/gpt-oss-20b:free                  (20B, 131K ctx — fast response)
#   default       → deepseek/deepseek-v4-flash-20260731      (PAID — primary, user's main model)
#
# --- FREE MODEL FALLBACK CHAIN (per task) ---
#   If primary PAID model fails (rate limit / quota / network):
#     1. Try task-specific FREE model (above)
#     2. Try openrouter/free (auto-router picks any available FREE model)
#     3. Try Ollama (local, free, unlimited)
#     4. Return None
#
# Override any task model below (uncomment + edit). Default = task mapping above.
# OPENROUTER_MODEL_AUTOFIX=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODEL_WHY=google/gemma-4-31b-it:free
# OPENROUTER_MODEL_LEARNING=google/gemma-4-31b-it:free
# OPENROUTER_MODEL_FAST_LEARNING=nvidia/nemotron-3-nano-30b-a3b:free
# OPENROUTER_MODEL_JUDGE=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_CHAT=openai/gpt-oss-20b:free
#
# --- ADVANCED: Use OTHER free models for specific tasks ---
# Code generation alternatives:
#   OPENROUTER_MODEL_AUTOFIX=poolside/laguna-s-2.1:free           (code-focused)
#   OPENROUTER_MODEL_AUTOFIX=cohere/north-mini-code:free          (code-focused)
# Multilingual alternatives:
#   OPENROUTER_MODEL_WHY=inclusionai/ling-3.0-tiny:free           (multilingual)
# Multimodal (image/video understanding):
#   OPENROUTER_MODEL_WHY=google/gemma-4-26b-a4b-it:free           (image+text)
#   OPENROUTER_MODEL_WHY=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free  (audio+image+video)
# Speed (smaller models = faster):
#   OPENROUTER_MODEL_CHAT=nvidia/nemotron-nano-9b-v2:free         (9B — fastest)
#   OPENROUTER_MODEL_FAST_LEARNING=nvidia/nemotron-nano-12b-v2-vl:free       (12B)
# Content moderation:
#   OPENROUTER_MODEL_JUDGE=nvidia/nemotron-3.5-content-safety:free (safety-focused)
# Auto-router (let OpenRouter pick best free model):
#   OPENROUTER_MODEL_DEFAULT=openrouter/free

# === Web Search via OpenRouter ===
WEB_SEARCH_MODEL=YOUR_WEB_SEARCH_MODEL_HERE

# === Wikipedia ===
WIKIPEDIA_USER_AGENT=YOUR_WIKIPEDIA_USER_AGENT_HERE

# === Specialized APIs ===
# PubMed/NCBI: https://www.ncbi.nlm.nih.gov/books/NBK25501/
PUBMED_API_KEY=YOUR_PUBMED_API_KEY_HERE
NCBI_API_KEY=YOUR_NCBI_API_KEY_HERE

# [V5.8-API] EIA (US Energy Information Administration) — register at
# https://www.eia.gov/opendata/register.php (free). Leave empty to skip EIA
# calls (OpenNEM remains free, no key required).
EIA_API_KEY=

# [V5.8-API] USDA NASS QuickStats — register at
# https://quickstats.nass.usda.gov/api (free). Leave empty to fall back to
# local AgricultureDataSource DB.
USDA_API_KEY=

# [V5.8-API] NVD (NIST National Vulnerability Database) — optional, raises
# rate-limit when present. Register at https://nvd.nist.gov/developers
NVD_API_KEY=

# [V5.8-API] Caselaw Access Project (Case.law) — optional, raises rate-limit
# when present. Register at https://case.law/api/
CASE_LAW_API_KEY=

# === Groq (backup LLM + ASR + TTS) ===
# https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# === [REMOVED 44-A] DeepSeek / Anthropic / OpenAI direct providers ===
# User only uses Ollama (local, free) + OpenRouter (cloud). The 3 direct
# cloud providers below were dead code (no API keys configured → never used).
# Removing them simplifies the gateway + eliminates 20× 401 Unauthorized
# log entries per day from DeepSeek (ROOT-FIX 40-A tripped circuit breaker).
# If you need them back, restore from git history before commit 44-A.

# === Ollama (local LLM — MULTI-MODEL) ===
# [ROOT-FIX 44-A] Each SCP task type uses the model best suited for it.
# Install the models with:
#   ollama pull llama3.2
#   ollama pull qwen2.5:7b
#   ollama pull deepseek-r1:8b
# All entries below are overridable — no code change needed to swap models.
OLLAMA_ENABLED=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT=

# [ROOT-FIX 44-A] Multi-model routing — task → model mapping
# default/chat (fast — 3B)
OLLAMA_MODEL=
# code reasoning (strongest)
OLLAMA_MODEL_AUTOFIX=YOUR_OLLAMA_MODEL_AUTOFIX_HERE
# factual verify (multilingual)
OLLAMA_MODEL_WHY=YOUR_OLLAMA_MODEL_WHY_HERE
# summarization (multilingual)
OLLAMA_MODEL_LEARNING=YOUR_OLLAMA_MODEL_LEARNING_HERE
# speed (3B = fastest)
OLLAMA_MODEL_FAST_LEARNING=
# general reasoning (balanced)
OLLAMA_MODEL_JUDGE=YOUR_OLLAMA_MODEL_JUDGE_HERE

# ============================================================
# === SCP AUTOFIX — WORLD-CLASS GATES (DNA #7: AutoFix safe) ===
# ============================================================
# [TIER3-AUTO] Auto-approve Tier-3 logic-bug fixes (bare-except, fragile ==, etc.)
# WHY: Tier-3 bugs are safe to auto-fix (no logic change, only add logger/>=).
# Safety guards (engine.py:46-62):
#   1. RELAXATION patterns KHÔNG bao giờ auto (hard limit)
#   2. Rate limit: 5/giờ (MAX_TIER3_AUTO_PER_HOUR)
#   3. Auto-timeout 1h (TIER3_AUTO_TIMEOUT_SECONDS)
#   4. Audit log: data/tier3_auto_audit.jsonl
#   5. Backup file trước khi apply (.tier3bak)
#   6. Cooldown 1h cho cùng bug (_recent_fixes)
# Set to "1" to enable, "0" to disable (default).
SCP_AUTO_APPROVE_TIER3=

# [WORLD-CLASS-GATE] pytest verify sau mỗi patch (engine.py _verify_fix Check 5)
# WHY: 63% rollback rate (engine.py:55-56) xảy ra vì SCP KHÔNG chạy pytest.
# Bật gate này → pytest -x chạy trên patched file → FAIL = rollback ngay.
# Trade-off: +60s per patch (expensive but safe).
# Set to "1" to enable (RECOMMENDED for production), "0" to disable (default).
SCP_AUTOFIX_RUN_PYTEST=

# === SCP Core Settings ===
SCP_DEV_MODE=
SCP_ENABLE_CLOSED_LOOP=

# === SCP Auth ===
# Set a strong password for admin endpoints. Leave empty = admin endpoints disabled.
SCP_AUTH_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
SCP_AUTH_TOKEN_SECRET=YOUR_SCP_AUTH_TOKEN_SECRET_HERE

# === SCP CORS (comma-separated origins) ===
SCP_CORS_ORIGINS=http://localhost:3000

# === [OPT-43] SCP HTTPS + CSRF Hardening ===
# SCP_FORCE_HTTPS=0 → dev (no HTTPS redirect — works on localhost:8000)
# SCP_FORCE_HTTPS=1 → prod (auto 308 redirect HTTP → HTTPS)
# Note: CSRF is inherently mitigated by Bearer-token auth (no cookies).
# See scp/api_server.py [OPT-43] block for full rationale + OWASP refs.
SCP_FORCE_HTTPS=

# === SCP Learning Speed (seconds) ===
SCP_LEARN_INTERVAL_BURST=
SCP_LEARN_INTERVAL_FAST=
SCP_LEARN_INTERVAL_IDLE=

# === SCP Security ===
SCP_THREAT_SIMULATOR_INTERVAL=
SCP_THREAT_SIMULATOR_COUNT=
SCP_ATTACK_CRAWL_INTERVAL=YOUR_SCP_ATTACK_CRAWL_INTERVAL_HERE

# === Google Fact Check (cần key — để trống = skip) ===
# https://developers.google.com/fact-check/tools/api
GOOGLE_FACT_CHECK_API_KEY=

# === NASA (free, dùng DEMO_KEY cho production cần đăng ký) ===
NASA_API_KEY=

